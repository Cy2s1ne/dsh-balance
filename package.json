{
  "name": "@cy2s1ne/dsh-balance",
  "version": "0.3.0",
  "description": "DSH 插件：在输入框工具行实时显示当前模型所属 DeepSeek 账户的余额与峰谷计费时段（支持平台账号与 API Key 路由），点击展开明细与用量/充值入口。",
  "type": "module",
  "scripts": {
    "test": "node --test test/pricing.test.mjs test/host-balance.test.mjs"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "balance",
    "account",
    "peak",
    "offpeak",
    "pricing",
    "provider",
    "multi-account"
  ],
  "license": "MIT",
  "author": "Cy2s1ne",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cy2s1ne/dsh-balance.git"
  },
  "bugs": {
    "url": "https://github.com/Cy2s1ne/dsh-balance/issues"
  },
  "homepage": "https://github.com/Cy2s1ne/dsh-balance#readme",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
